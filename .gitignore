# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Environment & secrets
.env
.env.*
!.env.example

# Dependencies & builds
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/

# Logs
*.log

# Xcode
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.hmap
*.ipa
