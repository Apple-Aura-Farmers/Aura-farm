*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
# Package.resolved is tracked on purpose. The Supabase client brings seven more packages with
# it, and the version range in the project file would otherwise resolve differently on CI and
# on a teammate's machine.

# Claude Code local settings
.claude/

# Trained PyTorch weights. They are the source for the Core ML model, not something the
# app builds with, and each one is over the 5 MB limit the repo checks enforce.
*.pt

# Per-developer build settings (signing team). Start from Config/Local.example.xcconfig.
Config/Local.xcconfig

# Derived data from a command-line xcodebuild run.
testbuild/

# Derived data from a one-off build check, the same as testbuild/.
build-check/
