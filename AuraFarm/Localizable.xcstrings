    "Farmers or Locations" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petani atau lokasi"
          }
        }
      }
    },
    "Feeds the crop quickly but adds no organic carbon. Used alone for many seasons, it can leave paddy soil lower in carbon and more acidic. Moving toward organic fertilizer generally suits paddies better." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi makan tanaman dengan cepat tetapi tidak menambah karbon organik. Jika dipakai sendiri selama banyak musim, tanah sawah bisa makin rendah karbon dan makin asam. Beralih ke pupuk organik umumnya lebih cocok untuk sawah."
          }
        }
      }
    },
    "Fertilized" : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipupuk"
          }
        }
      }
    },
