    "Compared with the sample of %@, taken in the same water state. Small changes between samples are normal." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibandingkan dengan sampel tanggal %@, yang diambil dalam kondisi air yang sama. Perubahan kecil antarsampel itu wajar."
          }
        }
      }
    },
    "Confidence: %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingkat keyakinan: %@"
          }
        }
      }
    },
    "Contains both organic material and mineral or manufactured nutrients. Its effects depend on the composition and application." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengandung bahan organik sekaligus unsur hara mineral atau buatan pabrik. Efeknya bergantung pada komposisi dan cara pemberiannya."
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanjutkan"
          }
        }
      }
    },
    "Controls soil acidity and affects which nutrients plants can take up. In flooded rice soils, pH often moves toward near-neutral conditions after flooding." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengatur keasaman tanah dan memengaruhi unsur hara mana yang bisa diserap tanaman. Pada tanah padi sawah, pH sering bergeser mendekati netral setelah penggenangan."
          }
        }
      }
    },
