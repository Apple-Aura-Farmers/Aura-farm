          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk memindahkan sudut ini"
          }
        }
      }
    },
    "Drained" : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikeringkan"
          }
        }
      }
    },
    "Drained or dry when measured" : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikeringkan atau kering saat diukur"
          }
        }
      }
    },
    "Each point is one test. Counts from flooded and drained fields are not directly comparable, so the water state of each test is listed. A change over time is an association only: this chart does not show what caused it. Only the latest soil measurements are kept, so no soil trend can be shown." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap titik adalah satu uji. Hitungan dari sawah tergenang dan sawah kering tidak bisa langsung dibandingkan, jadi kondisi air setiap uji dicantumkan. Perubahan dari waktu ke waktu hanya menunjukkan hubungan: grafik ini tidak menunjukkan penyebabnya. Hanya pengukuran tanah terbaru yang disimpan, jadi tren tanah tidak bisa ditampilkan."
          }
        }
      }
    },
