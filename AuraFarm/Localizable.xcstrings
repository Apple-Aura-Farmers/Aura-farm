    "Tilled" : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diolah"
          }
        }
      }
    },
    "Tillering" : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fase anakan"
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini"
          }
        }
      }
    },
    "Too few to say" : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu sedikit untuk dinilai"
          }
        }
      }
    },
    "Too little was seen to judge the soil." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu sedikit yang terlihat untuk menilai tanah."
          }
        }
      }
    },
    "Too little was seen to suggest anything about the soil." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu sedikit yang terlihat untuk menyarankan apa pun tentang tanah ini."
          }
        }
      }
    },
    "Too much potassium may interfere with calcium or magnesium uptake." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalium yang terlalu banyak bisa mengganggu penyerapan kalsium atau magnesium."
          }
        }
