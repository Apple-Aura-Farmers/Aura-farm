    "Product name (optional)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama produk (opsional)"
          }
        }
      }
    },
    "Provisional target for flooded rice: about pH %@. Flooding often moves pH toward neutral, so a reading from dry soil may differ from the pH around the roots once the field is flooded." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target sementara untuk padi sawah: sekitar pH %@. Penggenangan sering menggeser pH ke arah netral, jadi hasil dari tanah kering bisa berbeda dengan pH di sekitar akar setelah sawah digenangi."
          }
        }
      }
    },
    "Recommendation" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekomendasi"
          }
        }
      }
    },
    "Recorded" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicatat"
          }
        }
      }
    },
    "Recorded by the field helper, separately from the microscope. Each reading is placed against provisional standards for flooded rice, not graded." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicatat oleh pendamping lapangan, terpisah dari mikroskop. Setiap hasil dibandingkan dengan standar sementara untuk padi sawah, bukan dinilai."
          }
        }
      }
    },
    "Releases nutrients slowly and adds carbon that feeds soil life, which generally suits paddies. Use composted material, as fresh manure under flooding can raise methane." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melepaskan unsur hara perlahan dan menambah karbon yang memberi makan kehidupan tanah, yang umumnya cocok untuk sawah. Gunakan bahan yang sudah dikomposkan, karena pupuk kandang segar dalam kondisi tergenang bisa meningkatkan metana."
          }
        }
      }
    },
    "Result" : {
