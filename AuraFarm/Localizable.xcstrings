    "Export field report as PDF" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspor laporan lapangan sebagai PDF"
          }
        }
      }
    },
    "Extra phosphorus may become less available to plants and may contribute to water-quality problems." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelebihan fosfor bisa kurang tersedia bagi tanaman dan bisa ikut menyebabkan masalah kualitas air."
