    },
    "Trends and notes" : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren dan catatan"
          }
        }
      }
    },
    "Try again" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba lagi"
          }
        }
      }
    },
    "Try not to let water sit still for long. Let fresh water flow in where you can." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usahakan air tidak menggenang diam terlalu lama. Alirkan air segar masuk jika memungkinkan."
          }
        }
      }
    },
    "Try tapping to start plotting the boundary points of the farm" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk mulai menandai titik-titik batas lahan"
          }
        }
      }
    },
    "Type" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
