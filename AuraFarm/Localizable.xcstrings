        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus petak ini?"
          }
        }
      }
    },
    "Derived mainly from plant, animal, manure, compost, or other biological materials. Nutrients often need microbial breakdown before becoming available, and it may add organic carbon." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berasal terutama dari tumbuhan, hewan, pupuk kandang, kompos, atau bahan hayati lain. Unsur haranya sering perlu diurai mikroba sebelum tersedia, dan pupuk ini bisa menambah karbon organik."
          }
        }
      }
    },
    "Discard changes" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buang perubahan"
          }
        }
      }
    },
