    "Between seasons, grow a cover crop like beans and dig it in." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di antara musim tanam, tanam tanaman penutup tanah seperti kacang-kacangan lalu benamkan ke tanah."
          }
        }
      }
    },
    "Between seasons, grow beans as a cover crop to keep living roots in the soil and add nitrogen." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di antara musim tanam, tanam kacang-kacangan sebagai tanaman penutup tanah agar ada akar hidup di tanah dan menambah nitrogen."
          }
        }
      }
    },
    "Biodiversity" : {
      "localizations" : {
