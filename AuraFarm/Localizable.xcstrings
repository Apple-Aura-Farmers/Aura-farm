        }
      }
    },
    "Phosphorus and some micronutrients may become less available." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fosfor dan beberapa unsur hara mikro bisa kurang tersedia."
          }
        }
      }
    },
    "Phosphorus cannot be negative." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fosfor tidak boleh negatif."
          }
        }
      }
    },
    "Phosphorus is low, and roots need it to grow strong." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fosfor rendah, dan akar membutuhkannya untuk tumbuh kuat."
          }
        }
      }
    },
    "Plants may become overly lush or soft, with greater lodging, disease, or nutrient-imbalance risk." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanaman bisa tumbuh terlalu rimbun atau lunak, dengan risiko rebah, penyakit, atau ketidakseimbangan hara yang lebih besar."
          }
        }
      }
    },
    "Plants may have weaker stems and poorer water regulation." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batang tanaman bisa lebih lemah dan pengaturan airnya kurang baik."
          }
        }
      }
    },
    "Plants may show pale leaves, weak growth, or poor tillering." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanaman bisa menunjukkan daun pucat, pertumbuhan lemah, atau anakan yang sedikit."
          }
        }
      }
    },
    "Plenty of soil life was seen, of several kinds." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banyak kehidupan tanah yang terlihat, dari beberapa jenis."
