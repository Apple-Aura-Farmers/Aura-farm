        }
      }
    },
    "Apple Intelligence is still getting ready. Try again in a moment." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence masih bersiap. Coba lagi sebentar lagi."
          }
        }
      }
    },
    "Apple Intelligence is taking too long. Try again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence terlalu lama. Coba lagi."
          }
        }
      }
    },
    "Apple Intelligence is turned off in Settings." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence dimatikan di Pengaturan."
          }
        }
      }
    },
    "Apple Intelligence on the phone only wrote the wording, which was checked first." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence di ponsel hanya menulis kata-katanya, yang sudah diperiksa terlebih dahulu."
          }
        }
      }
    },
    "Apple Intelligence writes advice in English only, so standard advice is shown." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence hanya menulis saran dalam bahasa Inggris, jadi saran standar yang ditampilkan."
          }
        }
      }
    },
    "Ask about draining the field briefly mid-season, then reflooding. It lets air into the soil." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan tentang mengeringkan sawah sebentar di pertengahan musim, lalu menggenanginya lagi. Ini membuat udara masuk ke tanah."
          }
        }
      }
    },
    "Ask an extension officer whether this pH matters for your flooded field before changing anything. Flooding can move the pH toward neutral." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan kepada penyuluh pertanian apakah pH ini berpengaruh untuk sawah Anda yang tergenang sebelum mengubah apa pun. Penggenangan bisa menggeser pH ke arah netral."
          }
        }
      }
    },
    "Ask an extension officer whether this pH needs action for flooded rice before changing anything." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan kepada penyuluh pertanian apakah pH ini perlu ditangani untuk padi sawah sebelum mengubah apa pun."
          }
        }
      }
    },
    "Ask your extension officer to check the balance of nitrogen, phosphorus and potassium before adding more." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta penyuluh pertanian memeriksa keseimbangan nitrogen, fosfor, dan kalium sebelum menambah pupuk."
          }
        }
      }
    },
    "Ask your extension officer whether this high pH needs any change for flooded rice." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan kepada penyuluh pertanian apakah pH tinggi ini perlu ditangani untuk padi sawah."
          }
        }
      }
    },
    "Ask your extension officer whether this low pH needs any change for flooded rice." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanyakan kepada penyuluh pertanian apakah pH rendah ini perlu ditangani untuk padi sawah."
          }
        }
      }
    },
    "Asked %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminta %@"
          }
        }
      }
    },
    "Avoid adding more fresh organic material to wet soil, and ask an extension officer about drainage." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindari menambah bahan organik segar ke tanah basah, dan tanyakan kepada penyuluh pertanian tentang drainase."
          }
        }
      }
    },
    "Avoid burning straw. It removes food for soil life." : {
      "extractionState" : "manual",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindari membakar jerami. Pembakaran menghilangkan makanan bagi kehidupan tanah."
